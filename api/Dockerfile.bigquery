# API de contingência: pontua pelo ML.PREDICT do BigQuery. Mesmo código da
# imagem principal, sem TensorFlow e sem o artefato do modelo.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    BACKEND=bigquery

WORKDIR /app

COPY requirements-bigquery.txt .
RUN pip install --no-cache-dir -r requirements-bigquery.txt

COPY app/ app/

RUN useradd --create-home api
USER api

CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8080}"]
